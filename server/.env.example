DATABASE_URL=postgres://baton:baton_local@localhost:5432/baton
# If 5432 is occupied, start Compose with POSTGRES_PORT=5433 and use localhost:5433 here.
PORT=3000
HOST=127.0.0.1
WORKER_CONCURRENCY=2
SESSION_JWT_ISSUER=baton
SESSION_JWT_AUDIENCE=baton-api
# Set a random secret of at least 32 bytes for Baton access tokens.
# SESSION_JWT_SECRET=
# APPLE_MUSIC_DEVELOPER_TOKEN=
# SPOTIFY_ACCESS_TOKEN=
# YOUTUBE_API_KEY=
# Set a base64-encoded 32-byte AES key to enable fan-out workers.
# TOKEN_ENCRYPTION_KEY=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# Sprint 4 requires SESSION_JWT_SECRET and TOKEN_ENCRYPTION_KEY.
# Native Apple sign-in identifiers/signing material (separate from Apple Music keys).
# APPLE_SIGNIN_CLIENT_ID=
# APPLE_SIGNIN_TEAM_ID=
# APPLE_SIGNIN_KEY_ID=
# APPLE_SIGNIN_PRIVATE_KEY=
# Set only when the Apple code was issued for this registered HTTPS redirect URI.
# APPLE_SIGNIN_REDIRECT_URI=
# Register these exact HTTPS callbacks in the corresponding provider consoles.
# SPOTIFY_REDIRECT_URI=https://your-host.example/api/connections/spotify/callback
# GOOGLE_REDIRECT_URI=https://your-host.example/api/connections/youtube_music/callback
# Comma-separated exact HTTPS client return targets; no wildcards.
# OAUTH_RETURN_TARGETS=https://your-host.example/connected
# Local-only compatibility with npm run session; leave unset for production.
# ALLOW_DEV_SESSIONS=1
